# HeatSink — environment for the OPTIONAL build-time AI summaries (task 8.2, R7.3).
#
# These variables are read ONLY by `scripts/summaries.ts` (run via `npm run
# summaries`) to generate AI-written summaries for the PRESET sites at build
# time. The browser NEVER calls Bedrock. If these are unset the script skips
# gracefully and the app uses the deterministic template for every site, so a
# normal `npm run build` needs none of this.
#
# Copy to `.env` and fill in. `.env` and `.env.*` are gitignored — NEVER commit
# real values.

# AWS region where your Bedrock model is enabled, e.g. us-east-1.
# AWS_DEFAULT_REGION is also accepted. If unset, the script skips Bedrock.
AWS_REGION=us-east-1

# Bedrock model id to use. Defaults to anthropic.claude-3-haiku-20240307-v1:0
# when unset. The model must be enabled in your account for the chosen region.
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Set to 1 to force the graceful skip even when a region/credentials exist
# (useful to keep summaries.json unchanged during a build).
# SKIP_BEDROCK=1

# AWS CREDENTIALS ARE NOT SET HERE. They are resolved by the standard AWS
# credential provider chain (env vars like AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY, shared ~/.aws/credentials profiles, SSO, or an
# instance/role). Never commit credentials to this repo.
